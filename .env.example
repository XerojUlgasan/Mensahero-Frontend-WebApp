# Mensahero Frontend Web App - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Your Supabase project URL
# Example: https://your-project-id.supabase.co
SUPABASE_URL=

# Your Supabase anonymous/public API key
# Find this in: Supabase Dashboard > Project Settings > API > anon/public key
SUPABASE_KEY=

# ============================================================================
# BACKEND API CONFIGURATION (Required)
# ============================================================================
# The base URL for your Mensahero backend API
# Can use either VITE_API_URL or API_URL (VITE_API_URL takes precedence)
# Example: https://api.mensahero.com or http://localhost:3000
VITE_API_URL=

# Alternative API URL variable (VITE_API_URL takes precedence if both are set)
# API_URL=

# ============================================================================
# NOTES
# ============================================================================
# - Vite only exposes variables with VITE_ prefix to your client-side code
# - SUPABASE_* variables are exposed due to custom envPrefix config in vite.config.ts
# - Never commit your actual .env file with real credentials
# - The app will throw errors if required variables are missing
# - For production, set these in your hosting platform's environment settings
